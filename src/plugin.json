{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Owner Operator Portal",
  "id": "mcd-oop-app",
  "backend": true,
  "executable": "gpx_oop",
  "info": {
    "keywords": ["app", "restaurants", "network", "portfolio", "operations"],
    "description": "Owner Operator Portal: every restaurant of an owner/operator, its network status and what needs attention.",
    "author": {
      "name": "Mcd"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [
      {
        "name": "Portfolio",
        "path": "img/screenshots/portfolio.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "links": [
      {
        "name": "Source code",
        "url": "https://github.com/Nursultan-ts-coder/OOP"
      },
      {
        "name": "Issues",
        "url": "https://github.com/Nursultan-ts-coder/OOP/issues"
      }
    ]
  },
  "includes": [
    {
      "type": "page",
      "name": "Portfolio",
      "path": "/a/%PLUGIN_ID%",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=13.2.0",
    "plugins": []
  }
}
